SECRET_KEY=smart-college-super-secret-key-12345
ADMIN_REGISTRATION_KEY=admin123
# Database (SQLite for local dev or MySQL/Aiven for production)
# SQLite example:
# DATABASE_URL=sqlite:///college_system.db
# Aiven MySQL example:
# DATABASE_URL=mysql+pymysql://avnadmin:<password>@<host>:<port>/defaultdb
# MYSQL_SSL_CA=ca.pem
DATABASE_URL=sqlite:///college_system.db
MYSQL_SSL_CA=ca.pem

# CORS Configuration (comma-separated allowed origins for Flask API)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=noreply@smartcollegesystem.com

# Google Identity Services (Backend Token Audience Verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAINS=
ALLOWED_GOOGLE_ADMIN_LOGIN=false

# Cloudinary Image Storage & CDN Integration (Free Tier: 25 Credits/Month)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
